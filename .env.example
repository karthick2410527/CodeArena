# Settings for `make up` / `docker compose up`. Copy this file to `.env` (next
# to docker-compose.yml); Compose reads it automatically. `.env` is ignored by
# git, so secrets put there are never committed.
#
#   cp .env.example .env

# Signs access tokens. At least 32 characters: openssl rand -hex 32
JWT_SECRET=

# ---- Sign in with Google -------------------------------------------------------
# 1. https://console.cloud.google.com/apis/credentials → Create credentials →
#    OAuth client ID → Web application.
# 2. Authorised redirect URI:  http://localhost:5173/login/oauth2/code/google
# 3. Paste the client ID and secret here, then `make up` again.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Sign in with GitHub -------------------------------------------------------
# 1. https://github.com/settings/developers → OAuth Apps → New OAuth App.
# 2. Homepage URL: http://localhost:5173
#    Authorization callback URL: http://localhost:5173/login/oauth2/code/github
# 3. Generate a client secret, paste both here, then `make up` again.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where provider sign-ins send the browser back to (the web app's address).
FRONTEND_URL=http://localhost:5173

# Host plans: publishing a contest needs a paid plan, taken through Razorpay.
# Until these are set, plans are "paid" with a built-in test checkout that
# moves no money (TEST_PAYMENTS=true). Fill them in only for real payments.
# HOST_PLAN_REQUIRED=false makes hosting free for everyone.
# 1. Sign up at https://dashboard.razorpay.com and stay in Test mode.
# 2. Settings -> API Keys -> Generate test key: copy the Key Id (rzp_test_...) and secret.
# 3. Settings -> Webhooks -> Add: URL https://<your public host>/api/v1/billing/webhook,
#    events payment.captured, order.paid and payment.failed, and a secret of your choice.
#    Locally, expose port 5173 with `cloudflared tunnel --url http://localhost:5173`.
#    Without a webhook, payments still count: the checkout result is verified too.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TEST_PAYMENTS=true
HOST_PLAN_REQUIRED=true

# ---- Production only (make prod-up, see docs/DEPLOY.md) ------------------------
# The domain Caddy serves with HTTPS; point its DNS A record at the server first.
DOMAIN=
# The database password (set it before the first start; it can't change later
# without resetting the database). openssl rand -hex 24
POSTGRES_PASSWORD=
