# Copy to .env. Only DATABASE_URL and JWT_SECRET are required.
# Every variable is documented in ../README.md#configuration.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fullstack
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BIND_ADDR=0.0.0.0:8080
CORS_ORIGIN=http://localhost:5173
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------- execution
# docker   one throw-away container per execution (recommended)
# local    a child process with POSIX rlimits (development and CI)
# disabled refuses to execute anything — correct for the API process
# Read ../docs/SECURITY.md before choosing.
RUNNER_STRATEGY=local
RUNNER_IMAGE=codearena-runner:cpp17
RUNNER_WORKDIR=/tmp/codearena
# uid/gid the local strategy drops to. Empty disables dropping; it only
# happens at all when the worker runs as root.
RUNNER_UID=65534
RUNNER_GID=65534
RUNNER_CONCURRENCY=4

MAX_SOURCE_BYTES=65536
MAX_INPUT_BYTES=65536
MAX_OUTPUT_BYTES=65536
COMPILE_TIMEOUT_SECS=15
# Ceilings a problem may ask for, whatever its own limits say.
MAX_TIME_LIMIT_MS=10000
MAX_MEMORY_LIMIT_MB=512
# Runs are ephemeral working state, not product data.
RUN_RETENTION_HOURS=24

# -------------------------------------------------------------------- queue
# kafka    real consumer group; needs a broker and the `kafka` cargo feature
# postgres the transactional outbox is the queue; no extra infrastructure
QUEUE_DRIVER=postgres
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=codearena.submissions
KAFKA_DLQ_TOPIC=codearena.submissions.dlq
KAFKA_GROUP_ID=codearena-judge

# Defaults to hostname-pid; set it when running several workers on one host.
# WORKER_ID=worker-1
WORKER_CONCURRENCY=2
# Judge attempts before a submission is dead-lettered with INTERNAL_ERROR.
MAX_JUDGE_ATTEMPTS=3
JUDGE_RETRY_BASE_MS=500
# A claim older than this is treated as abandoned and recovered.
CLAIM_TIMEOUT_SECS=120
QUEUE_POLL_INTERVAL_MS=500

# -------------------------------------------- Redis, limits, observability
# Empty disables caching; rate limits then fall back to an in-process counter.
REDIS_URL=redis://127.0.0.1:6379
PROBLEM_CACHE_TTL_SECS=60

RATE_LIMIT_ENABLED=true
# requests/seconds. 0/60 means unlimited.
RATE_LIMIT_LOGIN=10/60
RATE_LIMIT_REGISTER=5/3600
RATE_LIMIT_RUN=20/60
RATE_LIMIT_SUBMIT=10/60
# Reverse proxies in front of the API. 0 ignores X-Forwarded-For entirely,
# which is the safe default — see ../docs/SECURITY.md#rate-limits.
TRUSTED_PROXY_HOPS=0

METRICS_ENABLED=true
# The worker's own /metrics and /health. Judge metrics exist only there.
WORKER_METRICS_ADDR=0.0.0.0:9090
LOG_FORMAT_JSON=false
RUST_LOG=codearena_api=debug,tower_http=info,sqlx=warn
